# Public Supabase config exposed to the browser via /api/config.
# Do not put service role keys or private tokens here.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
# Alternative names also supported by /api/config:
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Upstash Redis for Vercel serverless API score/ban storage.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Admin-only ban management API token.
# Required for GET /api/ban?list=all and DELETE /api/ban?action=unban-all.
# Do not expose to frontend code.
BAN_ADMIN_TOKEN=""
# Alternative shared admin env name also supported:
# ADMIN_API_TOKEN=""
